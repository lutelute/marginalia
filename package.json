{
  "name": "marginalia",
  "version": "1.5.1",
  "description": "Markdown編集ツール - 校閲・コメント・バージョン管理機能付き",
  "main": "electron/main.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5190 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron scripts",
    "format": "prettier --write src electron scripts",
    "format:check": "prettier --check src electron scripts",
    "build:prod": "cross-env NODE_ENV=production vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:prod": "cross-env NODE_ENV=production electron .",
    "start": "npm run build:prod && npm run electron:prod",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never",
    "publish:mac": "npm run build:prod && electron-builder --mac --publish always",
    "postinstall": "electron-rebuild"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "annotation"
  ],
  "author": {
    "name": "lutelute",
    "email": "lutelute@example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.7.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.1",
    "vitest": "^4.1.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.marginalia.app",
    "productName": "Marginalia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "report-build-system/templates/",
        "to": "report-build-system/templates/",
        "filter": [
          "catalog.yaml"
        ]
      },
      {
        "from": "report-build-system/projects/",
        "to": "report-build-system/projects/",
        "filter": [
          "demo-*.yaml",
          "example-*.yaml"
        ]
      },
      {
        "from": "report-build-system/src/",
        "to": "report-build-system/src/",
        "filter": [
          "**/*.md"
        ]
      }
    ],
    "afterPack": "./scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "lutelute",
      "repo": "Marginalia"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@annotorious/react": "^3.7.19",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lang-markdown": "^6.2.3",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language-data": "^6.4.1",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.23.0",
    "@lezer/highlight": "^1.2.3",
    "@recogito/react-text-annotator": "^3.4.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.28",
    "mermaid": "^11.12.2",
    "node-pty": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "uuid": "^9.0.1"
  }
}
